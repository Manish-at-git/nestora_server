# Copy this file to .env. Never commit the real .env file or database credentials.
ENVIRONMENT=development
DEBUG=true

# A new database name; do not point this at the legacy Nestora database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nestora_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=nestora_auth

# Browser cookie settings. Production must use true and HTTPS.
SESSION_COOKIE_NAME=nestora_session
CSRF_COOKIE_NAME=nestora_csrf
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_TTL_HOURS=168

# Comma-separated origins allowed to make credentialed browser requests.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Password reset challenges are valid for this many minutes. Configure SMTP to
# deliver reset links; without it the API safely accepts requests but cannot
# send a usable link.
PASSWORD_RESET_TTL_MINUTES=30

# Brevo (formerly Sendinblue) Transactional Email API
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Nestora

# Set true to send homeowner registration emails after association onboarding.
SEND_ONBOARDING_EMAILS=false

# Optional Fernet key for encrypting sensitive bank credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Seed script creates this administrator unless you deliberately override it.
INITIAL_ADMIN_EMAIL=superadmin@nestora.io
INITIAL_ADMIN_PASSWORD=Admin@nestora2026

CLOUDINARY_CLOUD_NAME=koimyset
CLOUDINARY_API_KEY=623922146169512
